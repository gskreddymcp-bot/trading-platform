APP_NAME=Market Intelligence OS V1
APP_ENV=local
LOG_LEVEL=INFO

# mock or upstox
DATA_PROVIDER=mock

# SQLite default for quickest local run
DATABASE_URL=sqlite:///./market_intel_os_v1.db

# Optional Redis; app runs without it
REDIS_URL=redis://localhost:6379/0

# Upstox
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_ACCESS_TOKEN=

# Index instrument keys
NIFTY_INDEX_KEY=NSE_INDEX|Nifty 50
BANKNIFTY_INDEX_KEY=NSE_INDEX|Nifty Bank

# Default expiry for testing. In production this should be discovered from option contracts.
DEFAULT_NIFTY_EXPIRY=2026-05-28
DEFAULT_BANKNIFTY_EXPIRY=2026-05-27

# Scanner
SCAN_TOP_STOCK_LIMIT=100
RISK_REWARD_MIN=1.5
MAX_SETUPS_PER_SCAN=5
